# ── Secrets — NEVER commit ────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Runtime data (chat history, SQLite DBs, logged-in browser profile, vectors) ─
data/*
!data/.gitkeep

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ── Node / frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Editors / OS ──────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
