# ══════════════════════════════════════════════════════════════════════════════
#  SIA — configuration.  Copy to .env and fill in your keys:   copy .env.example .env
#  .env is git-ignored. Never commit real keys.
# ══════════════════════════════════════════════════════════════════════════════

# ── Required: LLM keys ────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_key_here          # chat replies (free key: console.groq.com)
OPENAI_API_KEY=your_openai_key_here      # planner, agents and vision (gpt-4o-mini)

# ── Who SIA is talking to ─────────────────────────────────────────────────────
USER_NAME=YourName

# ── Models (defaults shown) ───────────────────────────────────────────────────
CHAT_PROVIDER=groq
CHAT_MODEL=llama-3.3-70b-versatile
PLANNER_PROVIDER=openai
PLANNER_MODEL=gpt-4o-mini
VISION_PROVIDER=openai
VISION_MODEL=gpt-4o-mini
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=

# ── Engine & safety ───────────────────────────────────────────────────────────
SIA_ENGINE=graph                 # graph (agents + approvals) | legacy (old regex/JSON router)
AUTO_APPROVE_LEVEL=2             # actions up to this risk level run without asking (1 = ask for everything)
LEVEL4_POLICY=confirm            # confirm (type CONFIRM) | block — deletes and destructive commands
APPROVAL_TIMEOUT_MIN=60
# ALLOWED_ROOTS=C:\Users\you\Desktop;C:\Users\you\Documents;D:\code
# EXTRA_ALLOWED_COMMANDS=docker;make

# ── Browser automation (Playwright) ───────────────────────────────────────────
BROWSER_CHANNEL=chrome           # chrome | msedge | chromium
BROWSER_HEADLESS=false           # keep false: you log in / pay in this window yourself

# ── Voice ─────────────────────────────────────────────────────────────────────
# Speech-to-text: Sarvam if SARVAM_API_KEY is set (auto-detects Hindi/Telugu/Marathi/English),
# otherwise local Whisper (needs ffmpeg on PATH).
# Text-to-speech: Sarvam → Edge TTS (internet) → Windows offline voice → browser voice.
SARVAM_API_KEY=                  # optional, best Indian-language voices (dashboard.sarvam.ai)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=ishita        # bulbul:v3 speakers: shubh, ishita, priya, aditya, kavya, rahul …
SARVAM_STT_MODEL=saaras:v3
WHISPER_MODEL=small              # tiny | base | small | medium  (small is good for Indian English)
WHISPER_LANGUAGE=auto            # auto | en | hi | te | mr
WAKE_WORD=hey sia

# ── Optional integrations ─────────────────────────────────────────────────────
# TAVILY_API_KEY=                # better web_search
# YOUTUBE_API_KEY=
# OPENWEATHER_API_KEY=
# NEWS_API_KEY=
LIVEKIT_ENABLED=false            # optional realtime voice room
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CHAT_WAIT_SECONDS=45             # /api/chat waits this long, then the answer arrives over the WebSocket
